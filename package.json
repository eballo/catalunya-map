  "description": "Interactive vectorial map of Catalunya based on a SVG/VML and the library RaphaëlJs.",
  "main": "index.js",
  "devDependencies": {
    "@babel/core": "^7.24.5",
    "@babel/preset-env": "^7.24.5",
    "@jest/globals": "^30.4.1",
    "babel-jest": "^30.4.1",
    "dotenv": "^17.4.2",
    "dotenv-webpack": "^9.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "ssh2-sftp-client": "^12.1.1",
    "webpack": "^5.88.2",
    "webpack-cli": "^7.0.2",
    "webpack-dev-server": "^5.2.4"
  },
  "scripts": {
    "test": "jest",
    "testWatch": "jest --watch",
    "clearCache": "jest --clearCache",
